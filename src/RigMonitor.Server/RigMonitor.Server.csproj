<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\RigMonitor.Core\RigMonitor.Core.csproj" />
    <ProjectReference Include="..\RigMonitor.Telemetry\RigMonitor.Telemetry.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Radiant" Version="0.1.2" />
    <PackageReference Include="SyslogLogging" Version="2.3.1" />
    <PackageReference Include="Watson" Version="7.2.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="clean.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="clean.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.2.1-alpha</Version>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DashboardDistDir>$(MSBuildThisFileDirectory)..\..\dashboard\dist\</DashboardDistDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(DashboardDistDir)index.html')">
    <Content Include="$(DashboardDistDir)**\*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
