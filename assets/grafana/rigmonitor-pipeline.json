          "expr": "sum(rigmonitor_db_lock_waiting)",
          "legendFormat": "waiting"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rigmonitor_db_lock_in_use)",
          "legendFormat": "in use"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(rigmonitor_db_lock_capacity)",
          "legendFormat": "capacity"
        }
