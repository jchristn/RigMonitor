{
  "uid": "rigmonitor-overview",
  "title": "RigMonitor / Overview",
  "description": "One-glance health snapshot for RigMonitor.",
  "tags": [
    "rigmonitor"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Start here",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "One-glance health of this RigMonitor process. Drill into **HTTP** (slow or failing endpoints), **Snapshots & Sections** (which telemetry section is slow or failing), **Collector & Retention** (background persistence pipeline), **Integrations** (DCGM, native GPU sources, Ollama, vLLM, Utilyze, SQLite, subprocesses), and **Runtime** (.NET process). Traces are in Tempo (service `rigmonitor`), logs in Loki (`{service_name=\"rigmonitor\"}`)."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Up",
      "description": "Watson server up gauge.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(watson_server_up)",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
